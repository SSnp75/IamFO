# IamFriendof Phase 0 environment (copy to .env for local dev; never commit .env)

# Selects Phase 0 stand-ins (in-process bus, Postgres search, JWT/DB rate limit).
DEPLOY_PHASE=0

# Session signing secret. MUST be >= 32 chars. Generate a random one for prod:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me-please-32b

# Neon free Postgres connection string (sign in with GitHub at neon.tech).
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/iamfriendof?sslmode=require

# Per-IP request cap per minute at the gateway.
RATE_LIMIT_PER_MINUTE=1000

# Public base URL for images served from Cloudflare R2 via the CDN (optional in dev).
MEDIA_PUBLIC_BASE_URL=

# Resend (or Brevo) API key for verification/notification emails (optional in dev).
EMAIL_API_KEY=

# Local dev server port.
PORT=8787
